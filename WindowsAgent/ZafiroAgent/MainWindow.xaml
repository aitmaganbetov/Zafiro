<Window x:Class="ZafiroAgent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZafiroAgent"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="Zafiro Agent" WindowState="Maximized" WindowStyle="None" Background="#0B0D12"
        FontFamily="Segoe UI" UseLayoutRounding="True">
    <Grid>
        <wv2:WebView2 x:Name="WebView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        <!-- Если WebView2 не запустился, ПК остаётся заблокированным, а на экране — эта подсказка. -->
        <TextBlock x:Name="UiError" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="640" FontSize="22" Foreground="#F3F4F6"
                   Text="Интерфейс агента не загрузился. Обратитесь к администратору клуба." />
    </Grid>
</Window>
