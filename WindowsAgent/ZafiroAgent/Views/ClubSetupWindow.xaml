<Window x:Class="ZafiroAgent.Views.ClubSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подключение к клубу Zafiro" WindowState="Maximized" WindowStyle="None"
        ResizeMode="NoResize" Background="#111019"
        FontFamily="Segoe UI" FontSize="14" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#302D3D"/>
            <Setter Property="Foreground" Value="#F5F3FA"/>
            <Setter Property="BorderBrush" Value="#4A465A"/>
            <Setter Property="CaretBrush" Value="#F5F3FA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#302D3D"/>
            <Setter Property="Foreground" Value="#F5F3FA"/>
            <Setter Property="BorderBrush" Value="#4A465A"/>
            <Setter Property="CaretBrush" Value="#F5F3FA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#7554C8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <!-- Глаз в поле пароля: показать введённое текстом и скрыть снова. -->
        <Style x:Key="EyeButton" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#AAA5B8"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Content" Value="&#xE7B3;"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#3D3950"/>
                                <Setter Property="Foreground" Value="#F5F3FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Круглая кнопка-иконка поверх картинки; Tag="armed" — ждёт второго нажатия (красная). -->
        <Style x:Key="PowerButton" TargetType="Button">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Background" Value="#73100E1A"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="26">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#CC7554C8"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="armed">
                                <Setter TargetName="Chrome" Property="Background" Value="#D90058"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#D90058"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="20" Background="#1B1925" CornerRadius="12" ClipToBounds="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="0.7*" MinWidth="440"/>
            </Grid.ColumnDefinitions>

            <!-- Картинка клуба — на всё окно; форма входа справа сверху поверх неё, без своего фона. -->
            <Grid Grid.Column="0" Grid.ColumnSpan="2">
                <!-- Картинку клуба (настройки клуба → «Картинка экрана входа») окно подставляет вместо этой. -->
                <Image x:Name="SignInImage" Source="pack://siteoforigin:,,,/Frontend/gaming-setup.jpg" Stretch="UniformToFill"/>
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#250B0D18" Offset="0"/>
                            <GradientStop Color="#120B0D18" Offset="0.45"/>
                            <GradientStop Color="#E60B0D18" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="34,30,24,24">
                    <TextBlock Text="ZAFIRO" FontSize="20" FontWeight="ExtraBold" Foreground="#FFFFFF"/>
                    <!-- Номер ПК и зона на полупрозрачной плашке: читаются поверх любой картинки. -->
                    <Border Margin="0,20,0,0" Padding="20,14,26,16" CornerRadius="14" Background="#73100E1A"
                            BorderBrush="#33FFFFFF" BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="ComputerText" FontSize="28" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock x:Name="ZoneText" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0" Foreground="#C9BEF5"/>
                            <!-- Версия агента: сотрудник видит на самом ПК, обновился ли он. -->
                            <TextBlock x:Name="VersionText" FontSize="13" Margin="0,8,0,0" Foreground="#AAA5B8"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Слева внизу: выключение и перезагрузка ПК (второе нажатие подтверждает) и язык интерфейса. -->
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="34,24,24,30">
                    <TextBlock x:Name="PowerHint" Visibility="Collapsed" Margin="0,0,0,12" FontSize="14" FontWeight="SemiBold"
                               Foreground="#FFFFFF" TextWrapping="Wrap" MaxWidth="360"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ShutdownButton" Style="{StaticResource PowerButton}" Content="&#xE7E8;"/>
                        <Button x:Name="RestartButton" Style="{StaticResource PowerButton}" Content="&#xE777;" Margin="12,0,0,0"/>
                        <!-- Язык выбирает клиент; после его выхода агент возвращает язык клуба. -->
                        <StackPanel x:Name="LanguagePanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Border Grid.Column="1" Background="Transparent">
                <!-- Прокрутка нужна только на маленьких экранах или при крупном масштабе Windows. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="38,28">
                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Stretch" MaxWidth="420">
                    <!-- Тень у подписей (не у полей ввода): белый текст читается на светлой картинке клуба. -->
                    <StackPanel.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.8" Color="#000000"/>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </StackPanel.Resources>
                    <TextBlock Text="ZAFIRO CLUB" Margin="0,0,0,14" FontSize="13" FontWeight="Bold" Foreground="#A78BFA"/>
                    <TextBlock x:Name="HeaderText" Text="Подключение к клубу" FontSize="30" FontWeight="SemiBold" Foreground="#F5F3FA" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ClubText" Margin="0,9,0,26" Foreground="#AAA5B8" FontSize="14" TextWrapping="Wrap"/>

                    <StackPanel x:Name="KeyPanel" Margin="0,0,0,4">
                        <TextBlock x:Name="KeyLabel" Text="Ключ установки" Foreground="#E8E5EF" FontSize="13" Margin="0,0,0,7"/>
                        <PasswordBox x:Name="ClubKeyBox" Margin="0,0,0,16" MaxLength="256"/>
                    </StackPanel>

                    <!-- Регистрация клиента: имя и повтор пароля видны только в этом режиме. -->
                    <StackPanel x:Name="NamePanel" Visibility="Collapsed">
                        <TextBlock x:Name="NameLabel" Text="Имя" Foreground="#E8E5EF" FontSize="13" Margin="0,0,0,7"/>
                        <TextBox x:Name="NameBox" Margin="0,0,0,16" MaxLength="255"/>
                    </StackPanel>

                    <TextBlock x:Name="PhoneLabel" Text="Телефон" Foreground="#E8E5EF" FontSize="13" Margin="0,0,0,7"/>
                    <Grid Margin="0,0,0,16">
                        <TextBox x:Name="PhoneBox" Padding="42,9,12,9" MaxLength="16" InputScope="TelephoneNumber"/>
                        <!-- Тот же шрифт и размер, что у поля ввода: «+7» и цифры стоят на одной линии. -->
                        <TextBlock Text="+7" Margin="13,0,0,0" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="#AAA5B8" IsHitTestVisible="False"/>
                        <!-- Подсказка формата, пока поле пустое (как на сайте). -->
                        <TextBlock x:Name="PhoneHint" Text="700 123-45-67" Margin="43,0,0,0" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="#5F5A6E" IsHitTestVisible="False"/>
                    </Grid>

                    <!-- Восстановление пароля: код из Telegram (второй шаг), затем новый пароль и его повтор. -->
                    <StackPanel x:Name="CodePanel" Visibility="Collapsed">
                        <TextBlock x:Name="CodeLabel" Text="Код из Telegram" Foreground="#E8E5EF" FontSize="13" Margin="0,0,0,7"/>
                        <TextBox x:Name="CodeBox" Margin="0,0,0,16" MaxLength="6" InputScope="Number"/>
                    </StackPanel>

                    <StackPanel x:Name="PasswordPanel">
                    <TextBlock x:Name="PasswordLabel" Text="Пароль" Foreground="#E8E5EF" FontSize="13" Margin="0,0,0,7"/>
                    <Grid Margin="0,0,0,8">
                        <PasswordBox x:Name="PasswordBox" Padding="12,9,100,9" MaxLength="256"/>
                        <TextBox x:Name="PasswordReveal" Padding="12,9,100,9" MaxLength="256" Visibility="Collapsed" IsUndoEnabled="False"/>
                        <Button x:Name="PasswordEye" Style="{StaticResource EyeButton}" Margin="0,0,58,0"/>
                        <!-- Раскладка клавиатуры Windows: панели задач в киоске нет, клиент видит язык ввода
                             здесь (как в трее). Нажатие — следующий язык, как Alt+Shift. -->
                        <Button x:Name="InputLanguageButton" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                                MinWidth="48" Height="26" Padding="8,0" FontSize="12" FontWeight="SemiBold"
                                Background="#3D3950" Foreground="#E8E5EF" Focusable="False" Cursor="Hand"/>
                    </Grid>
                    </StackPanel>

                    <StackPanel x:Name="ConfirmPanel" Visibility="Collapsed" Margin="0,8,0,0">
                        <TextBlock x:Name="ConfirmLabel" Text="Повторите пароль" Foreground="#E8E5EF" FontSize="13" Margin="0,0,0,7"/>
                        <Grid>
                            <PasswordBox x:Name="ConfirmBox" Padding="12,9,46,9" MaxLength="256"/>
                            <TextBox x:Name="ConfirmReveal" Padding="12,9,46,9" MaxLength="256" Visibility="Collapsed" IsUndoEnabled="False"/>
                            <Button x:Name="ConfirmEye" Style="{StaticResource EyeButton}" Margin="0,0,6,0"/>
                        </Grid>
                    </StackPanel>

                    <TextBlock x:Name="NoticeText" Visibility="Collapsed" Foreground="#86EFAC" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <TextBlock x:Name="ErrorText" Foreground="#FF7B83" FontSize="13" TextWrapping="Wrap" MinHeight="44" Margin="0,6,0,8"/>
                    <Button x:Name="SubmitButton" Content="Войти" Height="46" IsDefault="True"/>
                    <Button x:Name="RegisterToggle" Visibility="Collapsed" Margin="0,12,0,0" Height="34" Background="Transparent" Foreground="#C4B5FD" FontSize="14" FontWeight="SemiBold" Content="Нет аккаунта? Зарегистрироваться"/>
                    <Button x:Name="ForgotToggle" Visibility="Collapsed" Margin="0,4,0,0" Height="34" Background="Transparent" Foreground="#C4B5FD" FontSize="14" FontWeight="SemiBold" Content="Забыли пароль?"/>
                    <!-- Только при первой настройке: свернуть окно, открыть сайт и скопировать ключ установки. -->
                    <Button x:Name="MinimizeButton" Visibility="Collapsed" Margin="0,12,0,0" Height="34" Background="#3D3950" Foreground="#E8E5EF" FontSize="14" FontWeight="SemiBold" Content="Свернуть, чтобы скопировать ключ"/>

                    <!-- Вход с телефона: виден, только если клуб включил QR-код в настройках «Гости». -->
                    <Border x:Name="QrPanel" Visibility="Collapsed" Margin="0,22,0,0" Padding="16" Background="#2A2738" CornerRadius="10">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="White" CornerRadius="6" Padding="6" VerticalAlignment="Top">
                                <Image x:Name="QrImage" Width="132" Height="132" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Border>
                            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center" MaxWidth="220">
                                <TextBlock x:Name="QrTitle" Text="Вход с телефона" Foreground="#F5F3FA" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock x:Name="QrHint" Text="Наведите камеру телефона на QR-код, войдите на сайте и подтвердите вход." Margin="0,6,0,0" Foreground="#AAA5B8" FontSize="13" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</Window>
