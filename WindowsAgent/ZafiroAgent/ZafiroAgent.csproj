<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>1.0.0</Version>
    <Product>Zafiro Agent</Product>
    <Company>Zafiro</Company>
    <!-- Program.Main выбирает режим: агент или служба Windows (ключ service). -->
    <StartupObject>ZafiroAgent.Program</StartupObject>
    <!-- Логотип Zafiro: значок exe, ярлыка на рабочем столе и значка в трее. -->
    <ApplicationIcon>Assets\zafiro.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Размер сборки: без Windows Forms (значок в трее — через Win32), системные сообщения .NET
       только на русском, без XML-документации пакетов и без отладочных символов в Release. -->
  <PropertyGroup>
    <SatelliteResourceLanguages>ru</SatelliteResourceLanguages>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="System.Management" Version="10.0.12" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- Frontend из корня репозитория копируется в <выход>\Frontend: именно там его ищет MainWindow. -->
    <Content Include="..\Frontend\**\*" Link="Frontend\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
