<Window x:Class="ZafiroAgent.Views.AdminSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки администратора" Height="460" Width="580" WindowStartupLocation="CenterOwner" Background="#0B0D12">
    <Grid Margin="18">
        <StackPanel>
            <TextBlock Text="Адрес Laravel API" Foreground="#F3F4F6"/>
            <TextBox x:Name="ApiUrlBox" Margin="0,6,0,12"/>

            <TextBlock Text="Ключ регистрации агента" Foreground="#F3F4F6"/>
            <PasswordBox x:Name="AgentKeyBox" Margin="0,6,0,12"/>

            <TextBlock Text="ID ПК (обновляется после входа)" Foreground="#F3F4F6"/>
            <TextBox x:Name="ComputerIdBox" Margin="0,6,0,12" MaxLength="64"/>

            <TextBlock Text="Зона (обновляется после входа)" Foreground="#F3F4F6"/>
            <TextBox x:Name="ZoneBox" Margin="0,6,0,12" MaxLength="64"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="BtnSave" Content="Сохранить" Width="120" Margin="6" />
                <Button x:Name="BtnClose" Content="Закрыть" Width="120" Margin="6" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
